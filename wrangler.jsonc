{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linguaflyapp1",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "minify": true,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "linguaflyapp1" }],
  "images": { "binding": "IMAGES" },
  "send_email": [{ "name": "EMAIL", "remote": true, "allowed_sender_addresses": ["noreply@linguafly.app"] }],
  "ai": { "binding": "AI" },
  "ratelimits": [{ "name": "AI_RATE_LIMITER", "namespace_id": "610154781", "simple": { "limit": 30, "period": 60 } }],
  "d1_databases": [
    { "binding": "DB", "database_name": "blog", "database_id": "476f34d4-5622-4a56-923e-c4fb571578c2", "migrations_dir": "migrations/d1" },
    { "binding": "COURSE_DB", "database_name": "linguafly-learning", "database_id": "0982f4a2-ce92-410a-9e72-e5a34c461612" }
  ],
  "previews": {
    "d1_databases": [
      { "binding": "DB", "database_name": "linguafly-preview", "database_id": "b159641b-1910-49ec-b2ed-fbfae2440377", "migrations_dir": "migrations/d1" },
      { "binding": "COURSE_DB", "database_name": "linguafly-learning-preview", "database_id": "7e4e332b-6b37-4b4c-905f-390e1ef0f79a" }
    ],
    "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": [] }],
    "ratelimits": [{ "name": "AI_RATE_LIMITER", "namespace_id": "610154782", "simple": { "limit": 30, "period": 60 } }],
    "ai": { "binding": "AI" },
    "images": { "binding": "IMAGES" }
  }
}
